{
  "expo": {
    "name": "ПитВет - AI Ветеринар",
    "slug": "PetVet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petvet.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.petvet.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото для анализа здоровья питомца",
          "cameraPermission": "Доступ к камере для фото питомца"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0e165bd-071f-47f9-80e8-0da503f2a3e9"
      }
    },
    "owner": "lessmer-app"
  }
}
